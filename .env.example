# Gateway base URL (defaults to production in src/lib/api.ts)
EXPO_PUBLIC_API_URL=https://api.glianalabs.com

# Agent worker (gliana-agent repo). Unset = stub replies (the UI says the agent
# is not live yet). Point it at the deployed worker's public URL to go live.
# There is no same-origin proxy on mobile, so this must be the real URL:
# EXPO_PUBLIC_AGENT_URL=https://agent-worker.example.workers.dev

# Optional: custom Solana RPC for fetching a recent blockhash when paying.
# Defaults to @solana/mpp's public mainnet RPC (may rate-limit).
# EXPO_PUBLIC_SOLANA_RPC=https://your-solana-rpc.example.com
