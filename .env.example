# Gateway base URL (defaults to production in src/lib/api.ts)
EXPO_PUBLIC_API_URL=https://api.glianalabs.com

# Agent worker (gliana-agent repo). Unset = stub replies (the UI says the agent
# is not live yet). Point it at the deployed worker's public URL to go live.
# There is no same-origin proxy on mobile, so this must be the real URL:
# EXPO_PUBLIC_AGENT_URL=https://agent-worker.example.workers.dev

# Optional: custom Solana RPC for fetching a recent blockhash when paying.
# Defaults to @solana/mpp's public mainnet RPC (may rate-limit).
# EXPO_PUBLIC_SOLANA_RPC=https://your-solana-rpc.example.com

# ── Arena (SKR) ────────────────────────────────────────────────────────────
# Which chain the Arena program and its token live on. The shipping build is
# MAINNET, on real SKR: program 2CdzdzR1hj6w1ZjXLgvk3o2Saq5sXd1ufQ3Toww4PPHQ,
# deployed 2026-09-27.
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet
# Real SKR (6 decimals). For a devnet build set this to the mock mint
# 8799cfUwjoqSEqQNhTmGsNdLLmWcwF5fnQEv97srGbRD — SKR itself is mainnet-only.
EXPO_PUBLIC_SKR_MINT=SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3
# RPC for the Arena ONLY. Do not reuse EXPO_PUBLIC_SOLANA_RPC: that one is the
# mainnet endpoint the payment path takes its blockhash from, and the two want
# different clusters the moment you test the Arena on devnet — a devnet
# blockhash on a mainnet USDC transfer fails after the user has approved it.
EXPO_PUBLIC_ARENA_RPC=https://api.mainnet-beta.solana.com
