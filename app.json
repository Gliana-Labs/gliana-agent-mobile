{
  "expo": {
    "name": "Gliana Agent",
    "slug": "gliana-agent-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glianaagent",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0d",
    "primaryColor": "#f59e0b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glianalabs.agent"
    },
    "android": {
      "package": "com.glianalabs.agent",
      "versionCode": 1,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0e",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-image",
      "expo-video",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0e"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Gliana Agent to save generated media to your device.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gliana Agent to attach an image for image-to-video models."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7fdc0b78-2a93-4d07-85b9-41b6dea3b447"
      }
    },
    "owner": "glianalabs"
  }
}
