{
  "expo": {
    "name": "Gliana Agent",
    "slug": "gliana-agent-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "glianaagent",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0d",
    "primaryColor": "#f59e0b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glianalabs.agent"
    },
    "android": {
      "package": "com.glianalabs.agent",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0d",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-image",
      "expo-video",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0d"
        }
      ]
    ]
  }
}
